CI_ENVIRONMENT=production
database.default.hostname=host.docker.internal
database.default.port=3307
database.default.database=caresys
database.default.username=REPLACE_WITH_RESTRICTED_ACCOUNT
database.default.password=REPLACE_WITH_SECRET
database.default.DBDriver=MySQLi
session.driver=CodeIgniter\Session\Handlers\FileHandler
session.savePath=/var/www/html/writable/session
cookie.secure=true
billing.stripeSecretKey=REPLACE_WITH_STRIPE_SECRET_KEY
billing.stripeWebhookSecret=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
billing.webBaseURL=https://localhost:9443
billing.automaticTax=false
