# Local CareSys development. Serve only the public directory.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = 127.0.0.1
database.default.port = 3307
database.default.database = caresys
database.default.username = caresys_app
database.default.password = 'SET_LOCAL_APPLICATION_PASSWORD'
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.strictOn = true

# Schema credentials are used only by the caresys:migrate CLI command.
database.migrations.hostname = 127.0.0.1
database.migrations.port = 3307
database.migrations.database = caresys
database.migrations.username = caresys_migrate
database.migrations.password = 'SET_LOCAL_MIGRATION_PASSWORD'

# Tests must use the isolated MySQL schema.
database.tests.hostname = 127.0.0.1
database.tests.port = 3307
database.tests.database = caresys_test
database.tests.username = caresys_test
database.tests.password = 'SET_LOCAL_TEST_PASSWORD'
# Mobile browser approval host (separate from the native API host).
mobile.webBaseURL = 'https://localhost:8444/'
mobile.apiBaseURL = 'https://127.0.0.1:8443/'
